# App
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3333

# API
PORT=3333
# Worker health (opcional)
# WORKER_HEALTH_PORT=3334
# Runtime: role sem BYPASSRLS (RLS ativa)
DATABASE_URL=postgresql://app_user:app@localhost:5432/odonto_dev?schema=public
# Migrações: superuser local / app_migrator em prod
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/odonto_dev?schema=public
REDIS_URL=redis://localhost:6379

# Auth (dev only — replace in production)
# JWT keys = Base64(PEM PKCS8 / SPKI). Never commit production keys.
JWT_PRIVATE_KEY=<base64-of-pkcs8-pem>
JWT_PUBLIC_KEY=<base64-of-spki-pem>
REFRESH_TOKEN_TTL_DAYS=30

# Storage (MinIO local / S3 prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=odonto-dev
STORAGE_REGION=sa-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Mail (Mailpit local; Resend em produção via RESEND_API_KEY)
MAIL_DSN=smtp://localhost:1025
MAIL_FROM=noreply@localhost

# WhatsApp (placeholders)
WHATSAPP_APP_SECRET=dev-whatsapp-secret
WHATSAPP_VERIFY_TOKEN=dev-verify-token

# Crypto KEK (local VPS — never commit real key)
# KEK_LOCAL_BASE64=

# Optional
# SENTRY_DSN=
# RESEND_API_KEY=
