{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --config ../eslint.config.mjs",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "echo \"no tests yet\"",
    "test:kms": "tsx scripts/check-kms.ts",
    "test:rls": "tsx scripts/check-rls.ts",
    "test:identity": "tsx scripts/smoke-identity.ts",
    "test:clinic": "tsx scripts/smoke-clinic.ts",
    "test:patients": "tsx scripts/smoke-patients.ts",
    "test:scheduling": "tsx scripts/smoke-scheduling.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/migrate-deploy.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@repo/contracts": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^14.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^11.0.0",
    "dependency-cruiser": "^16.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
